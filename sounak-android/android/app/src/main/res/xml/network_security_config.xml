<?xml version="1.0" encoding="utf-8"?>
<!--
  The backend is HTTPS (Render), so no cleartext exception is needed. This file
  now only makes the secure default explicit, so a future change cannot quietly
  reintroduce plaintext traffic.

  If you ever point the app at a plain-HTTP host again you would need a
  <domain-config cleartextTrafficPermitted="true"> block here AND
  androidScheme: 'http' in capacitor.config.ts — they are two separate blocks,
  and each fails as the same generic network error.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
