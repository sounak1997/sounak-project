# Node.js specific ignores (for my-angular-node-backend)
my-angular-node-backend/node_modules/
my-angular-node-backend/.env
my-angular-node-backend/npm-debug.log*

# Angular specific ignores (for my-angular-frontend)
my-angular-frontend/node_modules/
my-angular-frontend/dist/
my-angular-frontend/src/environments/environment*.ts.bak
my-angular-frontend/src/environments/environment.prod.ts.bak
my-angular-frontend/.angular/cache/
my-angular-frontend/coverage/
node_modules/

# General ignores (for both projects and your local setup)
.env
# gitignore only treats '#' as a comment at the START of a line. These three
# carried trailing comments, which made the patterns literally
# ".DS_Store          # macOS specific" and match nothing — which is why
# .DS_Store kept reappearing as untracked.
# macOS
.DS_Store
# IntelliJ IDEA
.idea/
# VS Code (drop this line if you do want settings committed)
.vscode/
*.log
npm-debug.log*
yarn-error.log*
.eslintcache
# Local deploy script (contains EC2 host, CloudFront distribution ID, PEM key path)
/deploy.sh

# Claude Code settings (machine-local paths and permissions)
.claude/

# Local secrets: admin logins, API keys, the Android signing keystore, env
# backups. Moved in from ~/Desktop/sounak-server-backup-20260902 on 2026-09-21.
# This repo has a public GitHub remote — NEVER commit anything in here.
/secrets/
# Gym admin/owner/staff logins, kept at the top level so it is easy to find.
/GYM-LOGINS.md
