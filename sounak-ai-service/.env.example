# Copy this file to `.env` and fill in your real key.
# .env is gitignored — never commit your key.

# Get a FREE key (no credit card) at https://aistudio.google.com/
#   → sign in with Google → "Get API key" → create key
GEMINI_API_KEY=your-key-here

# Which Gemini model answers. Swap freely:
#   gemini-2.5-flash       → balanced, free tier (default)
#   gemini-2.5-flash-lite  → fastest + cheapest
#   gemini-2.5-pro         → most capable
MODEL=gemini-2.5-flash

# Hard cap on the length of each reply (in tokens).
MAX_TOKENS=1024
